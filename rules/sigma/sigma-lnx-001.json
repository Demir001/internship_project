{
    "id": "sigma-lnx-001",
    "title": "Access to Sensitive Password Hashes (/etc/shadow)",
    "status": "production",
    "level": "high",
    "tags": [
        "attack.credential_access",
        "attack.t1003.008"
    ],
    "detection": {
        "selection": {
            "process.command_line|contains": [
                "/etc/shadow",
                "/etc/gshadow",
                "/etc/security/opasswd"
            ]
        },
        "condition": "selection"
    }
}