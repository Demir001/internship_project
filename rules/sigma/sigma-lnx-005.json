{
    "id": "sigma-lnx-005",
    "title": "Persistence via Cron Table Hijacking",
    "status": "production",
    "level": "high",
    "tags": [
        "attack.persistence",
        "attack.t1053.003"
    ],
    "detection": {
        "selection": {
